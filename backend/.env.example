# 复制为 .env 后填写。这些环境变量会在启动时覆盖数据库中的对应设置。
# 页面设置（⚙️）里填的 Key 优先存在 SQLite，重启不丢；环境变量优先级更高。

# Anthropic API Key（模型 anthropic/claude-sonnet-5 等）
ANTHROPIC_API_KEY=

# OpenAI API Key（模型 openai/gpt-4o 等）
OPENAI_API_KEY=

# DeepSeek API Key（模型 deepseek/deepseek-chat 等，OpenAI 兼容）
DEEPSEEK_API_KEY=

# 可选：OpenAI 兼容网关（如 One API / 中转），在设置页填写 base_url 与 key
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# 可选：Ollama 本地模型（模型填 ollama/模型名）
# OLLAMA_BASE_URL=http://localhost:11434

# 可选：自定义工作区目录（默认 F:/MyAgent/workspace）
# MYAGENT_WORKSPACE=C:/path/to/your/project
